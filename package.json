{
  "name": "bapbap-launcher",
  "version": "4.0.2",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "description": "BAPBAP Nexus — The BAPBAP modding suite. Built on the legacy of Sonic0810's BAPBAP Launcher.",
  "author": "Sonic0810 & BAPBAP Community",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:harness": "vite --config vite.harness.config.ts --force",
    "sync:rebalance-vendor": "node scripts/sync-rebalance-vendor.mjs",
    "build": "electron-vite build && npm run sync:rebalance-vendor",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "smoke:nav": "node scripts/nav-smoke.mjs",
    "smoke:interaction": "node scripts/interaction-smoke.mjs",
    "smoke:radio": "node scripts/radio-click-smoke.mjs",
    "verify:all": "npm run verify && npm run smoke:nav && npm run smoke:interaction && npm run smoke:radio",
    "build:win": "npm run build && electron-builder --config electron-builder.yml --publish never --win --x64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.66.0",
    "@tauri-apps/api": "^2.11.1",
    "adm-zip": "^0.5.16",
    "animejs": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.4.0",
    "electron-store": "^8.2.0",
    "fs-extra": "^11.3.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.8.6",
    "@types/react": "^18.0.33",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.0.11",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.58.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
